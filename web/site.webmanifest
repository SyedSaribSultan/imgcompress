{
  "name": "Pocketsize",
  "short_name": "Pocketsize",
  "id": "/",
  "description": "Image and video compression that proves it didn't ruin your file. Runs entirely on your device — nothing is uploaded.",
  "start_url": "/",
  "display": "standalone",
  "categories": ["photo", "video", "utilities"],
  "background_color": "#070605",
  "theme_color": "#070605",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [
    {
      "action": "/",
      "accept": {
        "image/png": [".png"],
        "image/jpeg": [".jpg", ".jpeg"],
        "image/webp": [".webp"],
        "image/gif": [".gif"],
        "image/bmp": [".bmp"],
        "image/tiff": [".tif", ".tiff"],
        "image/avif": [".avif"],
        "video/mp4": [".mp4", ".m4v"],
        "video/quicktime": [".mov"],
        "video/webm": [".webm"],
        "video/x-matroska": [".mkv"]
      }
    }
  ],
  "launch_handler": { "client_mode": "focus-existing" }
}
